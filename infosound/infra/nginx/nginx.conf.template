worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  add_header_inherit merge;
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  log_format safe escape=json '{"time":"$time_iso8601","requestId":"$request_id","method":"$request_method","status":$status,"upstreamStatus":"$upstream_status","bytes":$body_bytes_sent}';
  access_log /dev/stdout safe;
  server_tokens off;
  client_body_temp_path /tmp/client;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  limit_req_zone $binary_remote_addr zone=auth:1m rate=5r/m;
  limit_req_zone $binary_remote_addr zone=api:1m rate=20r/s;
  map $request_method $upload_limit_key { default ""; PUT $binary_remote_addr; }
  limit_req_zone $upload_limit_key zone=upload:1m rate=10r/m;
  limit_req_status 429;
  map $http_origin $cors_origin { default ""; "__APP_ORIGIN__" "__APP_ORIGIN__"; __LOCAL_ORIGIN_RULE__ __LAN_ORIGIN_RULE__ }
  map $http_host $app_host_ok { default 0; __APP_MAIN_HOST_RULE__ __LOCAL_HOST_RULE__ __LAN_HOST_RULE__ }
  map $http_host $app_redirect_origin { default "__APP_ORIGIN__"; __LAN_HTTP_REDIRECT_RULE__ }
  map $http_host $media_host_ok { default 0; __MEDIA_HOST_RULE__ }
  resolver 127.0.0.11 valid=15s ipv6=off;
  ssl_certificate /run/secrets/server.crt;
  ssl_certificate_key /run/secrets/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:1m;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
  server {
    listen 8080 default_server;
    server_name _;
    location = /gateway-health { access_log off; return 200 'ok'; }
    location / { return 308 $app_redirect_origin$request_uri; }
  }
  server {
    listen 8443 ssl default_server;
    server_name __APP_HOST__;
    if ($app_host_ok = 0) { return 421; }
    client_max_body_size 1m;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: __MEDIA_ORIGIN__; media-src 'self' blob: __MEDIA_ORIGIN__; connect-src 'self' __MEDIA_ORIGIN__; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    location = /gateway-health { access_log off; return 200 'ok'; }
    location ~ ^/health/(live|ready)$ {
      set $api_upstream http://api:3001;
      proxy_pass $api_upstream;
      include /etc/nginx/infosound-proxy.conf;
    }
    location ~ ^/(internal|metrics|docs|openapi|swagger) { return 404; }
    location ^~ /api/v1/auth/ {
      # Native upstream errors can include callback authorization code/state.
      # Keep only the structured, query-free access record for auth requests.
      error_log /dev/null;
      limit_req zone=auth burst=10 nodelay;
      set $api_upstream http://api:3001;
      proxy_pass $api_upstream;
      include /etc/nginx/infosound-proxy.conf;
      add_header Cache-Control 'no-store' always;
    }
    location /api/ {
      limit_req zone=api burst=40 nodelay;
      client_max_body_size 8m;
      set $api_upstream http://api:3001;
      proxy_pass $api_upstream;
      include /etc/nginx/infosound-proxy.conf;
      add_header Cache-Control 'no-store' always;
    }
    location / {
      set $web_upstream http://web:3000;
      proxy_pass $web_upstream;
      include /etc/nginx/infosound-proxy.conf;
    }
  }
  server {
    listen 9443 ssl default_server;
    # Native request error messages include full signed query strings. Retain
    # structured status/upstreamStatus in the query-free access log instead.
    error_log /dev/null;
    server_name __APP_HOST__;
    if ($media_host_ok = 0) { return 421; }
    client_max_body_size 256m;
    client_body_timeout 120s;
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods 'GET, HEAD, PUT, OPTIONS' always;
    add_header Access-Control-Allow-Headers 'content-type,range,if-none-match,x-amz-checksum-crc32,x-amz-content-sha256,x-amz-sdk-checksum-algorithm' always;
    add_header Access-Control-Expose-Headers 'Content-Length,Content-Range,Accept-Ranges,ETag' always;
    add_header Vary Origin always;
    add_header Cache-Control 'private, no-store' always;
    location / {
      return 403;
    }
    # Raw image bytes are bounded before storage; keys are generated by the API.
    location ^~ /uploads-quarantine/images/ {
      if ($request_method = OPTIONS) { return 204; }
      limit_except PUT OPTIONS { deny all; }
      client_max_body_size 5m;
      client_body_timeout 30s;
      limit_req zone=upload burst=5 nodelay;
      set $s3_upstream http://__S3_PROXY_HOST__:8333;
      proxy_pass $s3_upstream;
      proxy_http_version 1.1;
      proxy_set_header Connection '';
      proxy_set_header Host $http_host;
      proxy_set_header Cookie '';
      proxy_set_header Authorization '';
      proxy_set_header X-Forwarded-For '';
      proxy_set_header X-Forwarded-Host '';
      proxy_set_header X-Forwarded-Proto '';
      proxy_hide_header Set-Cookie;
      proxy_hide_header Access-Control-Allow-Origin;
      proxy_hide_header Access-Control-Allow-Credentials;
      proxy_request_buffering off;
      proxy_buffering off;
      proxy_read_timeout 30s;
      proxy_send_timeout 30s;
      gzip off;
    }
    location ~ ^/(uploads-quarantine|audio-playback|artwork)/.+ {
      if ($request_method = OPTIONS) { return 204; }
      limit_except GET HEAD PUT OPTIONS { deny all; }
      limit_req zone=upload burst=15 nodelay;
      set $s3_upstream http://__S3_PROXY_HOST__:8333;
      proxy_pass $s3_upstream;
      proxy_http_version 1.1;
      proxy_set_header Connection '';
      proxy_set_header Host $http_host;
      proxy_set_header Cookie '';
      proxy_set_header Authorization '';
      proxy_set_header X-Forwarded-For '';
      proxy_set_header X-Forwarded-Host '';
      proxy_set_header X-Forwarded-Proto '';
      proxy_hide_header Set-Cookie;
      proxy_hide_header Access-Control-Allow-Origin;
      proxy_hide_header Access-Control-Allow-Credentials;
      proxy_request_buffering off;
      proxy_buffering off;
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
      gzip off;
    }
  }
}
