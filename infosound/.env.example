COMPOSE_PROJECT_NAME=infosound-local
LOCAL_DEPLOYMENT_MODE=true
APP_HOST=127.0.0.1
APP_ORIGIN=https://localhost:3443
# Google uses this same host; no SSH forward or VM is involved.
LOCAL_APP_ORIGIN=https://localhost:3443
# Leave the historical LAN alias disabled in the standalone local runtime.
LAN_APP_ORIGIN=
MEDIA_ORIGIN=https://localhost:9443
S3_PUBLIC_ENDPOINT=https://localhost:9443
APP_HTTP_PORT=18080
APP_HTTPS_PORT=3443
MEDIA_HTTPS_PORT=9443
# Copy this file to .env, then run `make bootstrap`. Secrets/certs are generated
# into SECRETS_DIR (repo-local and gitignored by default; no root required).
SECRETS_DIR=./.runtime/secrets
DATA_DIR=./.runtime/data
BACKUP_DIR=./.runtime/backups
EXTERNAL_WAF_ENABLED=false
TRUSTED_EDGE_PROXY_CIDRS=
# Email registration/reset is unavailable until real SMTP is configured.
# SMTP/OAuth JSON belong in the private secrets directory, not application source.
EMAIL_ENABLED=false
CONVERT_LOSSY_TO_FLAC=true
# Optional verified imported tag overrides when registry RepoDigests were not retained.
LOCAL_REDIS_IMAGE=redis:7.4.12-alpine
LOCAL_STORAGE_IMAGE=chrislusf/seaweedfs:4.51

# Comment moderation (server/background worker only). See ../comment-moderation/README.md
MODERATION_AI_ENABLED=true
MODERATION_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MODERATION_AI_AUTO_APPROVE=true
MODERATION_AI_TIMEOUT_MS=15000
MODERATION_AI_MAX_RETRIES=2
MODERATION_AI_CONCURRENCY=1
MODERATION_AI_MAX_OUTPUT_TOKENS=1024
MODERATION_AI_PENDING_MAX_AGE_SECONDS=120
MODERATION_AI_MAX_COMMENT_CHARS=2000
MODERATION_AI_MAX_CALLS_PER_MINUTE=2
MODERATION_AI_DAILY_CALL_LIMIT=200
MODERATION_AI_LOG_CONTENT=false
MODERATION_AI_AUDIT_RETENTION_DAYS=30
